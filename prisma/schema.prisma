generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  role      Role     @default(ADMIN)
}

model Airline {
  id        String    @id @default(cuid())
  name      String
  code      String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  packages  Package[]
}

model Hotel {
  id              String       @id @default(cuid())
  name            String
  city            String
  createdAt       DateTime     @default(now())
  address         String?
  updatedAt       DateTime     @updatedAt
  active          Boolean      @default(true)
  distance        String?
  email           String?
  phone           String?
  stars           Int
  thumbnail       String?
  website         String?
  images          HotelImage[]
  madinahPackages Package[]    @relation("MadinahHotel")
  makkahPackages  Package[]    @relation("MakkahHotel")
}

model HotelImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  hotelId   String
  createdAt DateTime @default(now())
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Package {
  id              String         @id @default(cuid())
  title           String
  createdAt       DateTime       @default(now())
  airlineId       String?
  updatedAt       DateTime       @updatedAt
  category        String?
  departureCity   String?
  description     String
  duration        String
  featured        Boolean        @default(false)
  meals           Boolean        @default(true)
  price           Float
  slug            String         @unique
  transport       Boolean        @default(true)
  visa            Boolean        @default(true)
  exclusions      String?
  inclusions      String?
  itinerary       String?
  madinahHotelId  String?
  madinahNights   Int            @default(0)
  makkahHotelId   String?
  makkahNights    Int            @default(0)
  brochure        String?
  childBedPrice   Float?
  childNoBedPrice Float?
  departureDate   DateTime?
  doublePrice     Float?
  flightNumber    String?
  infantPrice     Float?
  packageCode     String?        @unique
  quadPrice       Float?
  returnDate      DateTime?
  singlePrice     Float?
  status          String         @default("ACTIVE")
  triplePrice     Float?
  bookings        Booking[]
  enquiries       Enquiry[]
  airline         Airline?       @relation(fields: [airlineId], references: [id])
  madinahHotel    Hotel?         @relation("MadinahHotel", fields: [madinahHotelId], references: [id])
  makkahHotel     Hotel?         @relation("MakkahHotel", fields: [makkahHotelId], references: [id])
  images          PackageImage[]
}

model PackageImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  packageId String
  createdAt DateTime @default(now())
  brochure  String?
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model RoomType {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  capacity  Int
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  customerName  String
  email         String
  phone         String
  adults        Int
  children      Int
  travelDate    DateTime?
  totalAmount   Float
  paymentStatus PaymentStatus @default(UNPAID)
  status        BookingStatus @default(PENDING)
  packageId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  infants       Int
  roomType      String?
  package       Package       @relation(fields: [packageId], references: [id])
  payments      Payment[]
}

model Payment {
  id            String          @id @default(cuid())
  bookingId     String
  provider      PaymentProvider
  transactionId String?
  amount        Float
  createdAt     DateTime        @default(now())
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  packageId String?
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  package   Package?      @relation(fields: [packageId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  ACCOUNTANT
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DRAFT
  PENDING_PAYMENT
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYTABS
  TELR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}
