generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  ACCOUNTANT
  CUSTOMER
}

enum BookingStatus {
  DRAFT
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYTABS
  TELR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String

  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// AIRLINE
//////////////////////////////////////////////////////

model Airline {
  id        String   @id @default(cuid())

  name      String
  code      String?
  logo      String?

  packages  Package[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// HOTEL
//////////////////////////////////////////////////////

model Hotel {
  id        String   @id @default(cuid())

  name      String
  city      String
  stars     Int

  distance  String?
  address   String?

  phone     String?
  email     String?
  website   String?

  thumbnail String?

  active    Boolean @default(true)

  makkahPackages  Package[] @relation("MakkahHotel")
  madinahPackages Package[] @relation("MadinahHotel")

  images HotelImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelImage {
  id        String   @id @default(cuid())

  url       String
  alt       String?

  hotelId   String
  hotel     Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// PACKAGE
//////////////////////////////////////////////////////

model Package {
  id              String   @id @default(cuid())

  title           String
  slug            String   @unique

  packageCode     String?  @unique
  status          String   @default("ACTIVE")

  description     String   @db.Text

  duration        String
  category        String?

  departureCity   String?

  departureDate   DateTime?
  returnDate      DateTime?

  flightNumber    String?

  price           Float

  quadPrice       Float?
  triplePrice     Float?
  doublePrice     Float?
  singlePrice     Float?

  childBedPrice   Float?
  childNoBedPrice Float?
  infantPrice     Float?

  featured        Boolean @default(false)

  visa            Boolean @default(true)
  meals           Boolean @default(true)
  transport       Boolean @default(true)

  itinerary       String? @db.Text
  inclusions      String? @db.Text
  exclusions      String? @db.Text

  makkahNights    Int @default(0)
  madinahNights   Int @default(0)

  brochure        String?

  airlineId       String?
  airline         Airline? @relation(fields: [airlineId], references: [id])

  makkahHotelId   String?
  makkahHotel     Hotel? @relation("MakkahHotel", fields: [makkahHotelId], references: [id])

  madinahHotelId  String?
  madinahHotel    Hotel? @relation("MadinahHotel", fields: [madinahHotelId], references: [id])

  images          PackageImage[]
  bookings        Booking[]
  enquiries       Enquiry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PACKAGE IMAGE
//////////////////////////////////////////////////////

model PackageImage {
  id         String   @id @default(cuid())

  url        String
  alt        String?
  brochure   String?
  sortOrder  Int      @default(0)

  packageId  String
  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}

//////////////////////////////////////////////////////
// ROOM TYPE
//////////////////////////////////////////////////////

model RoomType {
  id        String   @id @default(cuid())

  name      String
  capacity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////

model Booking {
  id              String   @id @default(cuid())

  bookingNumber   String   @unique

  customerName    String
  email           String
  phone           String

  adults          Int
  children        Int
  infants         Int

  roomType        String?

  travelDate      DateTime?

  totalAmount     Float

  paymentStatus   PaymentStatus @default(UNPAID)
  status          BookingStatus @default(PENDING)

  packageId       String
  package         Package @relation(fields: [packageId], references: [id])

  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id            String @id @default(cuid())

  amount        Float

  provider      PaymentProvider

  transactionId String?

  bookingId     String
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// ENQUIRY
//////////////////////////////////////////////////////

model Enquiry {
  id         String @id @default(cuid())

  name       String
  email      String
  phone      String?

  subject    String?
  message    String

  status     EnquiryStatus @default(NEW)

  packageId  String?
  package    Package? @relation(fields: [packageId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}