generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  id              String         @id @default(cuid())
  title           String
  createdAt       DateTime       @default(now())
  airlineId       String?
  updatedAt       DateTime       @updatedAt
  category        String?
  destination     String?
  departureCity   String?
  description     String
  duration        String
  featured        Boolean        @default(false)
  meals           Boolean        @default(true)
  price           Float
  slug            String         @unique
  transport       Boolean        @default(true)
  visa            Boolean        @default(true)
  exclusions      String?
  inclusions      String?
  itinerary       String?
  madinahHotelId  String?
  madinahNights   Int            @default(0)
  makkahHotelId   String?
  makkahNights    Int            @default(0)
  brochure        String?
  childBedPrice   Float?
  childNoBedPrice Float?
  departureDate   DateTime?
  doublePrice     Float?
  flightNumber    String?
  infantPrice     Float?
  packageCode     String?        @unique
  quadPrice       Float?
  returnDate      DateTime?
  singlePrice     Float?
  status          String         @default("ACTIVE")
  triplePrice     Float?
  hotel3Price     Float?
  hotel4Price     Float?
  hotel5Price     Float?
  region          String?
  bookings        Booking[]
  enquiries       Enquiry[]
  airline         Airline?       @relation(fields: [airlineId], references: [id])
  madinahHotel    Hotel?         @relation("MadinahHotel", fields: [madinahHotelId], references: [id])
  makkahHotel     Hotel?         @relation("MakkahHotel", fields: [makkahHotelId], references: [id])
  images          PackageImage[]
  Quote           Quote[]
}

model PackageImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  packageId String
  createdAt DateTime @default(now())
  brochure  String?
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Hotel {
  id              String       @id @default(cuid())
  name            String
  city            String
  createdAt       DateTime     @default(now())
  address         String?
  updatedAt       DateTime     @updatedAt
  active          Boolean      @default(true)
  distance        String?
  email           String?
  phone           String?
  stars           Int
  thumbnail       String?
  website         String?
  images          HotelImage[]
  madinahPackages Package[]    @relation("MadinahHotel")
  makkahPackages  Package[]    @relation("MakkahHotel")
}

model HotelImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  hotelId   String
  createdAt DateTime @default(now())
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Airline {
  id        String    @id @default(cuid())
  name      String
  code      String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  packages  Package[]
}

model RoomType {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  capacity  Int
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  customerName  String
  email         String
  phone         String
  adults        Int
  children      Int
  travelDate    DateTime?
  totalAmount   Float
  paymentStatus PaymentStatus @default(UNPAID)
  status        BookingStatus @default(PENDING)
  packageId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  infants       Int
  roomType      String?
  package       Package       @relation(fields: [packageId], references: [id])
  payment       Payment[]
}

model Payment {
  id            String          @id @default(cuid())
  bookingId     String
  provider      PaymentProvider
  transactionId String?
  amount        Float
  createdAt     DateTime        @default(now())
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String?
  message        String
  packageId      String?
  status         EnquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  service        String?
  source         String?
  travelDate     DateTime?
  travellers     Int?
  assignedTo     String?
  estimatedValue Float?
  nextFollowUpAt DateTime?
  lostReason     String?
  package        Package?      @relation(fields: [packageId], references: [id])
  Quote          Quote[]
}

model Quote {
  id           String      @id
  quoteNumber  String      @unique
  enquiryId    String
  packageId    String?
  customerName String
  email        String
  phone        String?
  adults       Int         @default(1)
  children     Int         @default(0)
  infants      Int         @default(0)
  roomType     String?
  travelDate   DateTime?
  subtotal     Float
  discount     Float       @default(0)
  totalAmount  Float
  validUntil   DateTime?
  status       QuoteStatus @default(DRAFT)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  Enquiry      Enquiry     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  Package      Package?    @relation(fields: [packageId], references: [id])

  @@index([enquiryId])
  @@index([packageId])
  @@index([status])
}

model User {
  id        String   @id
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  isActive  Boolean  @default(true)
  role      Role     @default(ADMIN)
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DRAFT
  PENDING_PAYMENT
  COMPLETED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYTABS
  TELR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
  QUALIFIED
  QUOTE_SENT
  FOLLOW_UP
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  ACCOUNTANT
  CUSTOMER
}
